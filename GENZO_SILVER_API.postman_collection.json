    {
      "name": "📋 Orders",
      "item": [
        {
          "name": "Create Order (Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data) {",
                  "    pm.environment.set('order_id', res.data.orderId || '');",
                  "    pm.environment.set('order_number', res.data.orderNumber || '');",
                  "    console.log('Order created:', res.data.orderNumber);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Test Customer\",\n  \"customerEmail\": \"test@example.com\",\n  \"customerPhone\": \"+923001234567\",\n  \"shippingAddress\": {\n    \"street\": \"123 Main Street\",\n    \"city\": \"Karachi\",\n    \"province\": \"Sindh\",\n    \"postalCode\": \"75000\",\n    \"country\": \"Pakistan\"\n  },\n  \"paymentMethod\": \"jazzcash\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"size\": \"M\",\n      \"quantity\": 1,\n      \"price\": 4500\n    }\n  ],\n  \"subtotal\": 4500,\n  \"shippingFee\": 450,\n  \"totalAmount\": 4950,\n  \"notes\": \"Please gift wrap\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          },
          "response": []
        },
        {
          "name": "Create Order (Guest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data) {",
                  "    pm.environment.set('order_id', res.data.orderId || '');",
