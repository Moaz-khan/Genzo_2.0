    {
      "name": "🛒 Cart",
      "item": [
        {
          "name": "Get Cart (Guest)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-session-id", "value": "{{session_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/cart",
              "host": ["{{base_url}}"],
              "path": ["cart"]
            }
          },
          "response": []
        },
        {
          "name": "Get Cart (Logged In)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/cart",
              "host": ["{{base_url}}"],
              "path": ["cart"]
            }
          },
          "response": []
        },
        {
          "name": "Add to Cart (Guest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.cartItemId) {",
                  "    pm.environment.set('cart_item_id', res.data.cartItemId);",
                  "    console.log('Cart item ID saved:', res.data.cartItemId);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-session-id", "value": "{{session_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{product_id}},\n  \"size\": \"M\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart",
              "host": ["{{base_url}}"],
              "path": ["cart"]
            }
          },
          "response": []
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-session-id", "value": "{{session_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/{{cart_item_id}}",
              "host": ["{{base_url}}"],
              "path": ["cart", "{{cart_item_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Set Cart Item Quantity (Exact)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-session-id", "value": "{{session_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/{{cart_item_id}}",
              "host": ["{{base_url}}"],
              "path": ["cart", "{{cart_item_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-session-id", "value": "{{session_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/cart/{{cart_item_id}}",
              "host": ["{{base_url}}"],
              "path": ["cart", "{{cart_item_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Clear Entire Cart",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-session-id", "value": "{{session_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/cart",
              "host": ["{{base_url}}"],
              "path": ["cart"]
            }
          },
          "response": []
        }
      ]
    },

